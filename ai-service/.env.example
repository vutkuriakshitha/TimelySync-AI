PORT=8000
MONGODB_URI=mongodb://localhost:27017/timelysync
AI_INTERNAL_API_KEY=replace-with-a-shared-secret-matching-the-java-backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
LOG_LEVEL=INFO

# --- LLM document understanding (optional but recommended) ---
# Leave LLM_API_KEY empty to use only the built-in ML pipeline.
# Option A: Google Gemini (free tier available, create a key in Google AI Studio)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Option B: Groq / any OpenAI-compatible API
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a model id from the provider's model list>
LLM_TIMEOUT_S=45
LLM_MAX_INPUT_CHARS=24000
