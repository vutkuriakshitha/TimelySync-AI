# Copy to `.env`. Never commit real secrets.

PORT=8080
MONGODB_URI=mongodb://localhost:27017/timelysync
JWT_SECRET=replace-this-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
AI_SERVICE_URL=http://localhost:8010
AI_INTERNAL_API_KEY=replace-with-a-shared-secret-matching-the-ai-service

# -------- Gmail SMTP (required for forgot-password emails) --------
# 1) Enable 2-Step Verification on the Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-character App Password into MAIL_PASSWORD (spaces optional)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
MAIL_DEBUG=false

# false → API returns the exact Gmail SMTP error if send fails
ALLOW_IN_APP_RESET_FALLBACK=false

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
