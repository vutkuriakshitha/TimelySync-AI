# Copy to repo root as `.env` on the Oracle VM (never commit real secrets).
#   cp deploy/oracle/.env.example .env

# Same Atlas URI you use on Render (include /timelysync database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/timelysync?retryWrites=true&w=majority

# Long random strings (32+ chars)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AI_INTERNAL_API_KEY=replace-with-shared-secret-for-api-and-ai

# After Vercel deploy, set your real frontend URL here (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional email
MAIL_ENABLED=false
ALLOW_IN_APP_RESET_FALLBACK=true

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_MAX_REQUESTS=100
